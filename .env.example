# =============================================================================
# Salin file ini menjadi .env.local lalu isi dengan kredensial Supabase kamu.
# .env.local TIDAK ikut ter-commit ke git (sudah ada di .gitignore).
# =============================================================================

# Project Settings > API Keys di Supabase Dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# - Kalau dashboard project kamu sudah punya tab "API Keys" dengan
#   "Publishable key" (format sb_publishable_...), pakai nilai itu.
# - Kalau project kamu masih pakai sistem lama ("Legacy API Keys"), pakai
#   nilai "anon" / "anon public" - nilainya tetap valid untuk env var ini.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Catatan: project ini SENGAJA tidak memakai secret/service_role key di mana
# pun. Semua akses (baca publik & tulis oleh admin) diatur lewat Row Level
# Security + sesi login Supabase Auth, jadi lebih aman - lihat supabase/schema.sql.
